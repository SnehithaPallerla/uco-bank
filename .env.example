# Copy to .env. Keep API signing credentials outside this project.
PORT=4173
# Storage backend: file (default) or oracle. Oracle mode requires the seeded UCO_POC schema.
UCO_STORAGE=file
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=ucobank_high
# Path to the extracted wallet folder containing tnsnames.ora and ewallet.pem.
ORACLE_CONFIG_DIR=
# This is the wallet-download password, separate from ORACLE_PASSWORD.
ORACLE_WALLET_PASSWORD=
# Regular chat: local, oci-verified (AI selects code-owned facts), oci-grounded, or oci-rules.
UCO_ASSISTANT_MODE=local
OCI_ASSISTANT_MAX_TOKENS=4000
# Leave these blank to use the prepared demonstration without OCI calls.
OCI_REGION=
OCI_COMPARTMENT_ID=
OCI_MODEL_ID=
# GENERIC for compatible OpenAI/Meta models; COHERE for compatible Cohere models.
# Chicago example: OCI_REGION=us-chicago-1, OCI_MODEL_ID=openai.gpt-5.4-mini
OCI_CHAT_FORMAT=GENERIC
# Optional: default is your user profile's .oci/config, DEFAULT profile.
OCI_CONFIG_FILE=
OCI_CONFIG_PROFILE=DEFAULT
# Live research: Grok's model-specific OCI Responses API with web_search.
# Requires OCI signing above and Chicago, Ashburn or Phoenix; Chicago was live-tested.
# Independent of OCI_MODEL_ID, which can remain GPT Mini for the assistant.
OCI_WEB_SEARCH_MODEL_ID=xai.grok-4.20-multi-agent

# Optional Python override; defaults to project .venv-ml/Scripts/python.exe on Windows.
# UCO_ML_PYTHON=C:/path/to/python.exe
