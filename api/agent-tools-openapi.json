        "operationId": "read_loan_context",
        "summary": "read loan context",
        "security": [
          {
            "localSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped result"
          },
          "401": {
            "description": "Session missing or expired"
          },
          "403": {
            "description": "Access denied"
          },
          "404": {
            "description": "Record or tool unavailable"
          }
        },
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
