{
  "openapi": "3.0.3",
  "info": {
    "title": "UCO approved read-only agent tools",
    "version": "4.0.0",
    "description": "Deployment contract only. OCI Agent tools require a configured HTTPS endpoint and bank service identity. The calling service must propagate and authorize the actual officer subject; never trust a model-supplied role or branch."
  },
  "servers": [
    {
      "url": "https://bank-approved-api.example.invalid"
    }
  ],
  "paths": {
