          "401": {
            "description": "Session missing or expired"
          },
          "403": {
            "description": "Access denied"
          },
          "404": {
            "description": "Record or tool unavailable"
          }
        },
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
